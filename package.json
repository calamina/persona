{
  "name": "persona",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "type": "module",
  "scripts": {
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "dev": "concurrently \"bun run --cwd api dev\" \"bun run --cwd web dev\"",
    "db": "bun run --cwd api db",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "bun run --cwd api db:generate",
    "db:migrate": "bun run --cwd api db:migrate"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "globals": "^17.6.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.8.4"
  }
}
