{
  "name": "persona",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "dev": "concurrently \"bun run --cwd api dev\" \"bun run --cwd web dev\"",
    "lint": "concurrently \"bun run --cwd api lint\" \"bun run --cwd web lint\"",
    "lint:fix": "concurrently \"bun run --cwd api lint:fix\" \"bun run --cwd web lint:fix\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "vue-eslint-parser": "^10.4.1"
  }
}
